# Render web service environment variables
SPRING_PROFILES_ACTIVE=prod
PORT=10000
SERVER_PORT=10000
JPA_SHOW_SQL=false

# Render Postgres should be copied here as a JDBC URL, for example:
# jdbc:postgresql://host:5432/database
DB_URL=jdbc:postgresql://RENDER_DB_HOST:5432/RENDER_DB_NAME
DB_USERNAME=RENDER_DB_USER
DB_PASSWORD=RENDER_DB_PASSWORD

# Render can generate this in render.yaml, or you can paste your own Base64 secret
JWT_SECRET=REPLACE_WITH_BASE64_JWT_SECRET
JWT_EXPIRATION_MS=604800000
GUEST_PROGRESS_EXPIRATION_MS=2592000000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ADMIN_NAME=System Admin
